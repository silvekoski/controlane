# Optional. Without a key the agent runs in scripted replay mode.
ANTHROPIC_API_KEY=

# Models (defaults shown)
AGENT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
DRIVER_MODEL=claude-opus-5-5

# Jev through OpenRouter's Decisions API (preferred)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Optional: real places for the GPS stop check (Google Places API, Nearby Search New).
# Without a key the stop check uses the simulated places of each event.
GOOGLE_MAPS_API_KEY=

# Optional: other decision models behind the generic adapter (see README "Checker adapters")
JEV_URL=
JEV_API_KEY=
LAYA_URL=
LAYA_FT_URL=

# Fine-tuned d1-3B and Laya on a Verda GPU. Start: scripts/verda/serve.sh up
# MODEL_SERVER_URL=http://127.0.0.1:8800
# MODEL_SERVER_USD_PER_HOUR=0.788
