{
  "name": "car-delivery-control-room-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "attachments:seed": "tsx scripts/seed-attachments.ts",
    "attachments:smoke": "tsx scripts/smoke-attachments.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo:prepare": "rm -rf attachments demo/control-room && mkdir -p demo/control-room/state demo/control-room/lib && cp -R ../attachments attachments && cp ../control-room/.data/state.json demo/control-room/state/ && cp ../control-room/lib/questions.ts ../control-room/lib/visual.ts ../control-room/lib/vision.ts demo/control-room/lib/ && npm run demo:snapshot",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
